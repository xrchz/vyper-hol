#!/bin/sh
# Regenerate or verify the 23 formal O1 IR self-regression bytecode fixtures.
# Usage (from any repository directory):
#   sh lowering/defs/formal-o1-bytecode-fixtures [--check]
set -eu

case $#:$* in
  0:) mode=write ;;
  1:--check) mode=check ;;
  *) echo "usage: sh lowering/defs/formal-o1-bytecode-fixtures [--check]" >&2; exit 2 ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/../.." && pwd)
fixture_dir=$script_dir/bytecode
cd "$repo_dir"

if ! command -v holbuild >/dev/null 2>&1; then
  echo "formal-o1-bytecode-fixtures: holbuild executable not found on PATH" >&2
  exit 2
fi
if [ ! -d "$fixture_dir" ]; then
  echo "formal-o1-bytecode-fixtures: missing fixture directory: $fixture_dir" >&2
  exit 2
fi

stage_dir=$(mktemp -d "$fixture_dir/.formal-o1-stage.XXXXXX")
runner_file=
cleanup() {
  [ -z "$runner_file" ] || rm -f "$runner_file"
  rm -rf "$stage_dir"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

entries='empty:empty.hex
noop:noop.hex
return_uint:return_uint.hex
return_arg:return_arg.hex
local_uint:local_uint.hex
add_arg:add_arg.hex
two_external:two_external.hex
storage_read:storage_read.hex
storage_write:storage_write.hex
deploy_storage:deploy_storage.hex
event_log:event_log.hex
indexed_event_log:indexed_event_log.hex
mixed_event_log:mixed_event_log.hex
hashmap_read:hashmap_read.hex
hashmap_write:hashmap_write.hex
if_bool:if_bool.hex
if_join:if_join.hex
for_pass:for_pass.hex
for_accum:for_accum.hex
for_continue:for_continue.hex
for_break:for_break.hex
internal_call:internal_call.hex
internal_call_arg:internal_call_arg.hex'

index=0
while IFS=: read -r name filename; do
  index=$((index + 1))
  runner_theory=formalO1FixtureWorker${index}_$(date +%s)_$$
  runner_file=$script_dir/${runner_theory}Script.sml
  cat > "$runner_file" <<EOF
Theory $runner_theory[no_sig_docs]
Ancestors evalCompilerBytecodeDefs evalCompiler
Libs writeCompilerBytecodeFixturesLib
val () = writeCompilerBytecodeFixturesLib.run ();
EOF
  echo "formal-o1-bytecode-fixtures: staging $name ($index/23)"
  FORMAL_O1_FIXTURE_NAME=$name \
  FORMAL_O1_FIXTURE_STAGE_DIR=$stage_dir \
    holbuild build "${runner_theory}Theory"
  rm -f "$runner_file"
  runner_file=
  if [ ! -f "$stage_dir/$filename" ]; then
    echo "formal-o1-bytecode-fixtures: worker did not produce $filename" >&2
    exit 1
  fi
done <<EOF
$entries
EOF

stage_count=$(find "$stage_dir" -type f -name '*.hex' | wc -l | tr -d ' ')
all_count=$(find "$stage_dir" -type f | wc -l | tr -d ' ')
if [ "$stage_count" != 23 ] || [ "$all_count" != 23 ]; then
  echo "formal-o1-bytecode-fixtures: incomplete or unexpected staged set ($stage_count expected files, $all_count total files)" >&2
  exit 1
fi

mismatches=
changed=0
while IFS=: read -r name filename; do
  staged=$stage_dir/$filename
  target=$fixture_dir/$filename
  if [ "$mode" = check ]; then
    if [ ! -f "$target" ] || ! cmp -s "$staged" "$target"; then
      echo "formal-o1-bytecode-fixtures: stale or missing $filename" >&2
      mismatches=1
    fi
  elif [ -f "$target" ] && cmp -s "$staged" "$target"; then
    :
  else
    tmp=$target.tmp.$$
    cp "$staged" "$tmp"
    mv -f "$tmp" "$target"
    changed=$((changed + 1))
  fi
done <<EOF
$entries
EOF

if [ -n "$mismatches" ]; then
  exit 1
fi

# Verify every comparison or atomic replacement in the parent process.
while IFS=: read -r name filename; do
  cmp -s "$stage_dir/$filename" "$fixture_dir/$filename" || {
    echo "formal-o1-bytecode-fixtures: $filename does not match staged output" >&2
    exit 1
  }
done <<EOF
$entries
EOF

echo "formal-o1-bytecode-fixtures: all 23 fixtures match formal_o1_ir_no_asm_opt ($changed updated)"

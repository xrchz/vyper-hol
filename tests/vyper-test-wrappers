#!/bin/sh
# Regenerate or verify the functional Vyper wrapper inventory and provenance.
# Usage (from any repository directory):
#   sh tests/vyper-test-wrappers [--check]
set -eu

case $#:$* in
  0:) mode=generate ; provenance_args= ;;
  1:--check) mode=check ; provenance_args=--check ;;
  *) echo "usage: sh tests/vyper-test-wrappers [--check]" >&2; exit 2 ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$script_dir"

if ! command -v holbuild >/dev/null 2>&1; then
  echo "vyper-test-wrappers: holbuild executable not found on PATH" >&2
  exit 2
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "vyper-test-wrappers: python3 executable not found" >&2
  exit 2
fi
if [ ! -d vyper-test-exports ] || [ ! -d generated ]; then
  echo "vyper-test-wrappers: expected tests/vyper-test-exports and tests/generated" >&2
  exit 2
fi

count_file=${TMPDIR:-/tmp}/vyper-test-wrapper-count.$$
runner_theory=vyperWrapperCommand$(date +%s)_$$
runner_file=$script_dir/${runner_theory}Script.sml
cleanup() {
  rm -f "$count_file" "$runner_file"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

script_dir_sml=$(printf '%s' "$script_dir" | sed 's/\\/\\\\/g; s/"/\\"/g')
cat > "$runner_file" <<EOF
Theory $runner_theory[no_sig_docs]
Libs vyperTestWrapperMainLib
val oldDir = OS.FileSys.getDir ();
val () = OS.FileSys.chDir "$script_dir_sml";
val () = vyperTestWrapperMainLib.run ();
val () = OS.FileSys.chDir oldDir;
EOF

VYPER_TEST_WRAPPER_MODE=$mode \
VYPER_TEST_WRAPPER_COUNT_FILE=$count_file \
  holbuild build "${runner_theory}Theory"

if [ ! -s "$count_file" ]; then
  echo "vyper-test-wrappers: HOL driver did not report an inventory count" >&2
  exit 1
fi
selected_count=$(cat "$count_file")
python3 vyper-test-provenance.py $provenance_args "$selected_count"
